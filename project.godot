; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="TITANS — Space Bridge"
config/description="Procedurally generated, fully explorable spacecraft cockpit with interactive instruments."
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1600
window/size/viewport_height=900


[input]

front={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87)]
}

back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83)]
}

left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65)]
}

right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68)]
}

interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)]
}

[rendering]

anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
